diff -ruN a/network/nativegoos.go b/network/nativegoos.go
--- a/network/nativegoos.go
+++ b/network/nativegoos.go
@@ -0,0 +1,15 @@
+package network
+
+import "runtime"
+
+// nativeGOOS reports the OS whose routing and interface code should run. With
+// NativeConfigDisabled set it returns "userspace", which no switch in this
+// package handles, so every route, address and interface change is skipped.
+//
+// Added by jellyfin-plugin-pangolin; not part of upstream newt.
+func nativeGOOS() string {
+	if NativeConfigDisabled {
+		return "userspace"
+	}
+	return runtime.GOOS
+}
